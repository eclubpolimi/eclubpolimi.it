---
import MainLayout from "../layouts/main.astro";
---

<MainLayout>
  <div
    class="min-h-screen bg-white transition-colors duration-300"
  >
    <!-- Hero Section -->
    <!-- <section class="bg-gradient-to-b from-brand-soft to-white py-20 px-5 pt-32">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6">
          Join E-Club Polimi
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Become part of Milan's most dynamic entrepreneurial community.
        </p>
      </div>
    </section> -->

    <!-- Join as a Student Section -->
    <section class="py-20 px-5 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2
            class="text-4xl md:text-5xl font-bold text-gray-900 mb-6"
          >
            Join as a Student
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Whether you're looking to engage with like-minded individuals, build
            your network, or take an active role in organizing events, E-Club
            Polimi has the right place for you.
          </p>
        </div>

        <!-- Driver Card -->
        <div
          class="bg-gradient-to-br from-brand-soft to-white rounded-2xl p-8 md:p-12 shadow-xl mb-12 border border-gray-200"
        >
          <h3
            class="text-3xl font-bold text-gray-900 mb-8 text-center"
          >
            Driver
          </h3>

          <div class="grid md:grid-cols-2 gap-6 mb-10">
            <!-- Left Column -->
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-brand flex-shrink-0 mt-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    Recognized Membership
                  </h4>
                  <p class="text-gray-600">
                    Be officially part of the E-Club Polimi community.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-brand flex-shrink-0 mt-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    Priority Event Access
                  </h4>
                  <p class="text-gray-600">
                    Reserve seats for exclusive workshops and speaker sessions.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-brand flex-shrink-0 mt-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    Members-Only Networking
                  </h4>
                  <p class="text-gray-600">
                    Connect with exclusive members of the community.
                  </p>
                </div>
              </div>
            </div>

            <!-- Right Column -->
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-brand flex-shrink-0 mt-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    Exclusive Learning Opportunities
                  </h4>
                  <p class="text-gray-600">
                    Engage in private discussions and events with top
                    innovators.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-brand flex-shrink-0 mt-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    Leadership & Event Planning
                  </h4>
                  <p class="text-gray-600">
                    Organize and execute high-impact E-Club initiatives.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-brand flex-shrink-0 mt-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    Specialized Training
                  </h4>
                  <p class="text-gray-600">
                    Gain hands-on skills through exclusive workshops.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-brand flex-shrink-0 mt-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <h4 class="font-semibold text-gray-900">
                    Professional Growth
                  </h4>
                  <p class="text-gray-600">
                    Develop teamwork, problem-solving, and entrepreneurial
                    expertise.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Apply Button -->
          <div class="text-center">
            <a
              href="https://docs.google.com/forms/d/1qzIRmfCmcqeDGpZFGiV3XX3aICm4fMtDmLdzCJ4ABo0/viewform?chromeless=1&edit_requested=true"
              target="_blank"
              rel="noopener noreferrer"
              
              class="bg-brand hover:bg-brand-deep inline-block text-white px-10 py-4 rounded-lg text-lg font-semibold transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-105 hover:brightness-110"
            >
              Apply Now!
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Partner with Us Section -->
    <section class="py-20 px-5 bg-gray-50">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2
            class="text-4xl md:text-5xl font-bold text-gray-900 mb-6"
          >
            Partner with Us
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            We collaborate with organizations, startups, and professionals to
            create impactful experiences for our members. If you're looking to
            share your expertise, mentor students, or contribute to our
            community, we'd love to hear from you.
          </p>
        </div>

        <!-- Collaborator Card -->
        <div
          class="bg-gradient-to-br from-orange-50 to-white rounded-2xl p-8 md:p-12 shadow-xl border border-gray-200"
        >
          <h3
            class="text-3xl font-bold text-gray-900 mb-8 text-center"
          >
            Collaborator
          </h3>

          <div class="space-y-6 mb-10 max-w-3xl mx-auto">
            <div class="flex items-start gap-4">
              <svg
                class="w-7 h-7 text-orange-600 flex-shrink-0 mt-1"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <h4 class="font-semibold text-lg text-gray-900">
                  Direct Access to Young Innovators
                </h4>
                <p class="text-gray-600">
                  Connect with ambitious students and future entrepreneurs.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <svg
                class="w-7 h-7 text-orange-600 flex-shrink-0 mt-1"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <h4 class="font-semibold text-lg text-gray-900">
                  Brand Visibility & Recognition
                </h4>
                <p class="text-gray-600">
                  Gain exposure through strategic sponsorship opportunities.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <svg
                class="w-7 h-7 text-orange-600 flex-shrink-0 mt-1"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <h4 class="font-semibold text-lg text-gray-900">
                  Mentorship & Industry Impact
                </h4>
                <p class="text-gray-600">
                  Share expertise and inspire the next generation.
                </p>
              </div>
            </div>
          </div>

          <!-- Apply Button -->
          <div class="text-center">
            <a
              href="https://docs.google.com/forms/d/1qzIRmfCmcqeDGpZFGiV3XX3aICm4fMtDmLdzCJ4ABo0/viewform?chromeless=1&edit_requested=true"
              target="_blank"
              rel="noopener noreferrer"
              
              class="bg-brand hover:bg-brand-deep inline-block text-white px-10 py-4 rounded-lg text-lg font-semibold transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-105 hover:brightness-110"
            >
              Apply Now!
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
